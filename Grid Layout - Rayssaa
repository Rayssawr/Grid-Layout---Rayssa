<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grade de Layout - Exemplo Aluno</title>
    <style>
        * {
            margem: 0;
            preenchimento: 0;
            box-sizing: border-box;
        }

        corpo {
            família-da-fonte: Arial, sem serifa;
            preenchimento: 20px;
            cor de fundo: #f5f5f5;
        }

        .grid-container {
            exibição: grade;
            grid-template-columns: 250px 1fr 1fr 1fr;
            grid-template-rows: 60px 300px 200px 80px;
            espaçamento: 15px;
            largura máxima: 1200px;
            margem: 0 auto;
        }

        .grid-container > * {
            exibição: flexível;
            alinhar-itens: centro;
            justificar-conteúdo: centralizado;
            peso da fonte: negrito;
            cor: #2c3e50;
            raio da borda: 4px;
        }

        .navbar {
            cor de fundo: #bffffa;
            coluna-grade: 1 / span 4;
            linha-da-grade: 1;
        }

        .sidebar {
            cor de fundo: #00ffff;
            coluna-grade: 1;
            linha-da-grade: 2 / span 2;
        }

        .principal {
            cor de fundo: #a8f5ff;
            coluna-grade: 2 / span 3;
            linha-da-grade: 2;
        }

        .content-1 {
            cor de fundo: #a6ffe8;
            coluna-grade: 2;
            linha-da-grade: 3;
        }

        .content-2 {
            cor de fundo: #7affdf;
            coluna-grade: 3;
            linha-da-grade: 3;
        }

        .content-3 {
            cor de fundo: #8affbd;
            coluna-grade: 4;
            linha-da-grade: 3;
        }

        .rodapé {
            cor de fundo: #1bdfb2;
            coluna-grade: 1 / span 4;
            linha-da-grade: 4;
        }
    </style>
</head>
<body>

    <div class="grid-container">
        <header class="navbar">NAVBAR</header>
        <aside class="sidebar">BARRA LATERAL</aside>
        <main class="main">PRINCIPAL</main>
        <section class="content-1">CONTEÚDO 1</section>
        <section class="content-2">CONTEÚDO 2</section>
        <section class="content-3">CONTEÚDO 3</section>
        <footer class="footer">RODAPÉ</footer>
    </div>

</body>
</html>
